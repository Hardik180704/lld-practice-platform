generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AttemptStatus {
  DRAFT
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

model Problem {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  summary          String
  context          String
  requirements     String[]
  evaluationHints  String[]
  difficulty       Difficulty
  estimatedMinutes Int
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         Attempt[]
  rubricCriteria   RubricCriterion[]

  @@index([isPublished, difficulty])
}

model RubricCriterion {
  id          String            @id @default(cuid())
  problemId   String
  key         String
  title       String
  description String
  maxScore    Int
  position    Int
  problem     Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results     CriterionResult[]

  @@unique([problemId, key])
  @@unique([problemId, position])
}

model Attempt {
  id             String         @id @default(cuid())
  learnerId      String
  problemId      String
  status         AttemptStatus  @default(DRAFT)
  version        Int
  idempotencyKey String         @unique
  startedAt      DateTime       @default(now())
  submittedAt    DateTime?
  completedAt    DateTime?
  failureReason  String?
  problem        Problem        @relation(fields: [problemId], references: [id], onDelete: Restrict)
  submission     Submission?
  evaluation     Evaluation?

  @@unique([learnerId, problemId, version])
  @@index([learnerId, startedAt(sort: Desc)])
}

model Submission {
  id          String   @id @default(cuid())
  attemptId   String   @unique
  assumptions String
  design      String
  tradeoffs   String
  edgeCases   String
  contentHash String
  createdAt   DateTime @default(now())
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id               String            @id @default(cuid())
  attemptId        String            @unique
  evaluator        String
  evaluatorVersion String
  overallScore     Int
  summary          String
  createdAt        DateTime          @default(now())
  attempt          Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  results          CriterionResult[]
}

model CriterionResult {
  id           String          @id @default(cuid())
  evaluationId String
  criterionId  String
  score        Int
  evidence     String[]
  concerns     String[]
  suggestions  String[]
  confidence   Float
  evaluation   Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
}
